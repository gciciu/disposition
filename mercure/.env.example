# Bind HTTP on localhost:3000 (no TLS — nginx terminates HTTPS in production)
SERVER_NAME=http://127.0.0.1:3000

# Must match backend MERCURE_JWT_SECRET (without surrounding quotes here)
MERCURE_PUBLISHER_JWT_KEY=!ChangeThisMercureHubJWTSecretKey!
MERCURE_SUBSCRIBER_JWT_KEY=!ChangeThisMercureHubJWTSecretKey!
MERCURE_PUBLISHER_JWT_ALG=HS256
MERCURE_SUBSCRIBER_JWT_ALG=HS256

# Local admin SPA on Vite :1420. Behind same-origin nginx you can use: cors_origins *
MERCURE_EXTRA_DIRECTIVES=cors_origins http://127.0.0.1:1420 http://localhost:1420
