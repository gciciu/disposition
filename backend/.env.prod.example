# =============================================================================
# Production overrides for CloudPanel
# Copy to the server as:  /var/www/delivery/backend/.env.local
#   cp .env.prod.example .env.local
# Then replace every REPLACE_* value. Do NOT commit .env.local.
# After editing:
#   php bin/console cache:clear --env=prod --no-warmup
#   php bin/console cache:warmup --env=prod
# =============================================================================

APP_ENV=prod
APP_SECRET=REPLACE_APP_SECRET_64_HEX

DATABASE_URL="mysql://delivery:REPLACE_DB_PASSWORD@127.0.0.1:3306/delivery?serverVersion=8.4.9&charset=utf8mb4"
# MariaDB example:
# DATABASE_URL="mysql://delivery:REPLACE_DB_PASSWORD@127.0.0.1:3306/delivery?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

JWT_PASSPHRASE=REPLACE_JWT_PASSPHRASE_64_HEX

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|tauri\.localhost|delivery\.produkt-konfigurator24\.de|driver\.produkt-konfigurator24\.de)(:[0-9]+)?$'

ADMIN_HOST=delivery.produkt-konfigurator24.de
DRIVER_HOST=driver.produkt-konfigurator24.de

GOOGLE_MAPS_API_KEY=REPLACE_GOOGLE_MAPS_API_KEY

# SMTP — URL-encode special chars in password (@ → %40, # → %23, / → %2F)
MAILER_DSN=smtp://REPLACE_SMTP_USER:REPLACE_SMTP_PASSWORD@smtp.example.com:587
MAIL_FROM=noreply@produkt-konfigurator24.de

COMPANY_NAME="MySpiegel-Lieferservice"
COMPANY_ADDRESS="Holländische Str. 207b, 34127 Kassel"
COMPANY_PHONE="+49561 2207980"
COMPANY_EMAIL="info@myspiegel.de"
COMPANY_WEBSITE="www.myspiegel.de"

MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=https://delivery.produkt-konfigurator24.de/.well-known/mercure
# Must match mercure hub JWT secret (mercure/.env / systemd unit)
MERCURE_JWT_SECRET=REPLACE_MERCURE_JWT_SECRET

DRIVER_APP_VERSION_CODE=1
DRIVER_APP_VERSION_NAME=0.1.0
DRIVER_APP_FORCE_UPDATE=0
DRIVER_APP_CHANGELOG=
DRIVER_APP_APK_FILENAME=driver.apk
