# Local overrides (not committed). Copy to .env.local and fill in values.

APP_ENV=dev
APP_SECRET=change_me_in_production_please_32chars

# Native MySQL 8 on localhost:3306
DATABASE_URL="mysql://delivery:delivery@127.0.0.1:3306/delivery?serverVersion=8.4.9&charset=utf8mb4"

JWT_PASSPHRASE=a917ac930906ad96217cfdba0cb85013b5d51e79e86925174c31806693a610e8
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|tauri\.localhost)(:[0-9]+)?$'

# Enable Geocoding API + Directions API + Places API for this key in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Outbound email (Symfony Mailer).
# Local: .\scripts\start-mailpit.ps1 → SMTP 1025, UI http://127.0.0.1:8025
# null://null discards messages (no SMTP). Production: real smtp://user:pass@host:587
MAILER_DSN=smtp://127.0.0.1:1025
MAIL_FROM=noreply@delivery.local

# Mercure hub (.\scripts\start-mercure.ps1 — same secret as mercure/.env)
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Driver Android self-update (optional locally). Place APK at backend/var/driver/driver.apk
DRIVER_APP_VERSION_CODE=1
DRIVER_APP_VERSION_NAME=0.1.0
DRIVER_APP_FORCE_UPDATE=0
DRIVER_APP_CHANGELOG=
DRIVER_APP_APK_FILENAME=driver.apk
