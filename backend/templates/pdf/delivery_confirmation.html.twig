<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{{ doc.documentTitle }} — Pos. {{ doc.position }}</title>
    <style>
        @page {
            margin: 16mm 16mm 18mm 16mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 10pt;
            color: #111;
            line-height: 1.4;
        }

        .company {
            margin-bottom: 22px;
        }

        .company-name {
            font-size: 14pt;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .company-line {
            font-size: 9pt;
            color: #333;
        }

        .doc-title {
            font-size: 16pt;
            font-weight: bold;
            margin: 0 0 12px;
        }

        .meta {
            margin-bottom: 18px;
        }

        .meta-row {
            margin: 0 0 3px;
        }

        .meta-label {
            font-weight: bold;
        }

        .section {
            margin: 0 0 16px;
        }

        .section-title {
            font-size: 11pt;
            font-weight: bold;
            margin: 0 0 8px;
            padding-bottom: 3px;
            border-bottom: 1px solid #333;
        }

        .field {
            margin: 0 0 3px;
        }

        .field-label {
            font-weight: bold;
        }

        .products {
            margin: 4px 0 6px;
            padding: 0;
            list-style: none;
        }

        .products li {
            margin: 0 0 2px;
        }

        .proof-block {
            margin-top: 8px;
            text-align: left;
        }

        .proof-block img {
            max-width: 100%;
            max-height: 320px;
            border: 1px solid #ccc;
        }

        .proof-missing {
            color: #888;
            font-size: 9pt;
            padding: 24px 0;
        }

        .page-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            font-size: 8pt;
            color: #666;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="company">
    <div class="company-name">{{ company.name }}</div>
    {% if company.address %}
        <div class="company-line">{{ company.address }}</div>
    {% endif %}
    {% if company.phone or company.email %}
        <div class="company-line">
            {% if company.phone %}Tel. {{ company.phone }}{% endif %}
            {% if company.phone and company.email %} &nbsp;-&nbsp; {% endif %}
            {% if company.email %}{{ company.email }}{% endif %}
        </div>
    {% endif %}
    {% if company.website %}
        <div class="company-line">{{ company.website }}</div>
    {% endif %}
</div>

<h1 class="doc-title">{{ doc.documentTitle }}</h1>

<div class="meta">
    <div class="meta-row"><span class="meta-label">Route:</span> {{ doc.routeLabel }}</div>
    <div class="meta-row"><span class="meta-label">Position:</span> {{ doc.position }}</div>
    <div class="meta-row"><span class="meta-label">Erstellt am:</span> {{ doc.createdAtLabel }}</div>
    <div class="meta-row"><span class="meta-label">Status:</span> {{ doc.statusLabel }}</div>
</div>

<section class="section">
    <h2 class="section-title">Kundendaten</h2>
    <div class="field"><span class="field-label">Kunde:</span> {{ doc.customerName }}</div>
    <div class="field"><span class="field-label">Adresse:</span> {{ doc.customerAddress }}</div>
    {% if doc.customerPhone %}
        <div class="field"><span class="field-label">Telefon:</span> {{ doc.customerPhone }}</div>
    {% endif %}
    {% if doc.customerEmail %}
        <div class="field"><span class="field-label">E-Mail:</span> {{ doc.customerEmail }}</div>
    {% endif %}
</section>

<section class="section">
    <h2 class="section-title">Lieferdetails</h2>
    <div class="field"><span class="field-label">Fahrer:</span> {{ doc.driverName|default('—') }}</div>
    <div class="field"><span class="field-label">Lieferdatum:</span> {{ doc.deliveryAtLabel }}</div>
    <div class="field"><span class="field-label">Liefermethode:</span> {{ doc.deliveryMethod }}</div>
</section>

<section class="section">
    <h2 class="section-title">Gelieferte Ware</h2>
    <div class="field"><span class="field-label">Artikel:</span></div>
    {% if doc.products %}
        <ul class="products">
            {% for product in doc.products %}
                <li>{{ product }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="field">—</div>
    {% endif %}
    {% if doc.weightKg is not null %}
        <div class="field">
            <span class="field-label">Gewicht:</span>
            {{ doc.weightKg|number_format(2, '.', '') }} kg
        </div>
    {% endif %}
</section>

{% if doc.additionalInfo %}
<section class="section">
    <h2 class="section-title">Zusätzliche Informationen</h2>
    <div>{{ doc.additionalInfo }}</div>
</section>
{% endif %}

<section class="section">
    <h2 class="section-title">{{ doc.proofSectionTitle }}</h2>
    <div class="proof-block">
        {% if doc.proofImageDataUri %}
            <img src="{{ doc.proofImageDataUri }}" alt="{{ doc.proofSectionTitle }}">
        {% else %}
            <div class="proof-missing">Kein Nachweisbild vorhanden</div>
        {% endif %}
    </div>
</section>

<div class="page-footer">Seite 1 von 1</div>

</body>
</html>
